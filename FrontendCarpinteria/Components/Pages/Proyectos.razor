    private int ContarPorEstado(string estadoNombre)
    {
        if (estadoNombre == "En espera")
            return proyectos.Count(p => string.IsNullOrEmpty(p.EstadoTaller) || p.EstadoTaller.Equals("En espera", StringComparison.OrdinalIgnoreCase));

        return proyectos.Count(p => p.EstadoTaller != null && p.EstadoTaller.Equals(estadoNombre, StringComparison.OrdinalIgnoreCase));
    }

    private void FiltrarEstado(string estado)
    {
        filtroEstado = estado;
        if (estado == "En espera")
            proyectosFiltrados = proyectos.Where(p => string.IsNullOrEmpty(p.EstadoTaller) || p.EstadoTaller.Equals("En espera", StringComparison.OrdinalIgnoreCase)).ToList();
        else
            proyectosFiltrados = proyectos.Where(p => p.EstadoTaller != null && p.EstadoTaller.Equals(estado, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private int ObtenerPorcentajeProgreso(string? estado)
    {
        return estado switch
        {
            "En proceso de cortes" => 20,
            "En proceso de cantos / bordes" => 40,
            "En proceso de armado / premontaje" => 60,
            "Listo para despacho / Retiro" => 80,
            "En proceso de instalación" => 90,
            "Finalizado" => 100,
            _ => 10
        };
    }

    private int ObtenerIdTallerPorNombre(string? nombre)
    {
        return nombre switch
        {
            "En proceso de cortes" => 2,
            "En proceso de cantos / bordes" => 3,
            "En proceso de armado / premontaje" => 4,
            "Listo para despacho / Retiro" => 5,
            "En proceso de instalación" => 6,
            "Finalizado" => 7,
            _ => 1
        };
    }

    private int ObtenerIdEstadoPorNombre(string? nombre)
    {
        return nombre switch
        {
            "En proceso" => 2,
            "En instalacion" => 3,
            "Finalizado" => 3, // Adaptado a la BD para no enviar un ID inexistente
            _ => 1 // En espera
        };
    }

    private void AbrirModalNuevo()
    {
        modeloNuevo = new CrearProyectoRequest
        {
            EstadoId = 1
        };
        clienteSeleccionado = null;
        usuarioSeleccionado = null;
        esEdicion = false;
        proyectoIdActual = 0;
        mostrarModal = true;
    }

    private void AbrirModalEditar(ProyectoListadoResponse proj)
    {
        string estadoTallerActual = string.IsNullOrEmpty(proj.EstadoTaller) ? "En espera" : proj.EstadoTaller;
        string estadoGeneralActual = proj.NombreEstado ?? "En espera";

        modeloEdicion = new ActualizarProyectoRequest
        {
            NombreProyecto = proj.NombreProyecto,
            EstadoTallerId = ObtenerIdTallerPorNombre(estadoTallerActual),
            EstadoId = ObtenerIdEstadoPorNombre(estadoGeneralActual)
        };

        clienteSeleccionado = listaClientes.FirstOrDefault(c => c.NombreApellido == proj.NombreCliente);
        if (clienteSeleccionado is not null)
        {
            modeloEdicion.ClienteId = clienteSeleccionado.ClienteId;
        }

        usuarioSeleccionado = listaUsuarios.FirstOrDefault(u => $"{u.Nombre} {u.Apellido}".Trim() == proj.NombreResponsable);
        if (usuarioSeleccionado is not null)
        {
            modeloEdicion.UsuarioId = usuarioSeleccionado.UsuarioId;
        }

        esEdicion = true;
        proyectoIdActual = proj.ProyectoId;
        mostrarModal = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task GuardarNuevoProyecto()
    {
        if (modeloNuevo.ClienteId <= 0)
        {
            Snackbar.Add("Debe seleccionar un cliente válido.", Severity.Warning);
            return;
        }
        if (modeloNuevo.UsuarioId <= 0)
        {
            Snackbar.Add("Debe seleccionar un usuario responsable.", Severity.Warning);
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/proyectos", modeloNuevo);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("¡Orden de trabajo creada con éxito!", Severity.Success);
                mostrarModal = false;
                await CargarProyectos();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
        }
    }

    private async Task GuardarEdicionProyecto()
    {
        if (modeloEdicion.ClienteId <= 0)
        {
            Snackbar.Add("Debe seleccionar un cliente válido.", Severity.Warning);
            return;
        }
        if (modeloEdicion.UsuarioId <= 0)
        {
            Snackbar.Add("Debe seleccionar un usuario responsable.", Severity.Warning);
            return;
        }

        try
        {
            var response = await Http.PutAsJsonAsync($"api/proyectos/{proyectoIdActual}", modeloEdicion);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("¡Orden de trabajo actualizada!", Severity.Success);
                mostrarModal = false;
                await CargarProyectos();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
        }
    }

