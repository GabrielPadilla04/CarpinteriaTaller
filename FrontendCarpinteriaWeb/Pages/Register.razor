@page "/register"
@using FrontendCarpinteriaWeb
@using FrontendCarpinteriaWeb.Services
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthService AuthService

<div class="onboarding-container">
    <div class="d-flex align-items-center mb-3" style="max-width: 450px; width: 100%; margin: 0 auto;">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Class="text-dark bg-light rounded-circle shadow-sm p-2"
                       OnClick="VolverAlLogin" />
        <span class="ms-3 fw-bold" style="font-size: 16px; color: #111827;">Crear cuenta</span>
    </div>

    <div class="register-wrapper">
        <div class="shield-badge shadow-sm">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="text-white" Style="font-size: 28px;" />
        </div>

        <div class="register-card shadow-sm">
            <div class="register-header text-center mb-4">
                <h3>Registro de Usuario</h3>
                <span>Completa tus datos para comenzar a gestionar tu taller</span>
            </div>

            <EditForm Model="registerModel" OnValidSubmit="HandleRegister">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="input-label">Nombre</label>
                    <MudTextField @bind-Value="registerModel.Nombre"
                                  Placeholder="Ej. Juan"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Person"
                                  Class="custom-input rounded-lg" />
                </div>

                <div class="mb-3">
                    <label class="input-label">Apellido</label>
                    <MudTextField @bind-Value="registerModel.Apellido"
                                  Placeholder="Ej. Pérez"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.PersonOutline"
                                  Class="custom-input rounded-lg" />
                </div>

                <div class="mb-3">
                    <label class="input-label">Email</label>
                    <MudTextField @bind-Value="registerModel.Email"
                                  Placeholder="usuario@gmail.com"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email"
                                  Class="custom-input rounded-lg" />
                </div>

                <div class="mb-4">
                    <label class="input-label">Contraseña</label>
                    <MudTextField @bind-Value="registerModel.Password"
                                  Placeholder="Mínimo 6 caracteres"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Lock"
                                  Class="custom-input rounded-lg" />
                </div>

                <MudButton Variant="Variant.Filled"
                           ButtonType="ButtonType.Submit"
                           Class="btn-dark-custom mb-3"
                           FullWidth="true"
                           Disabled="isLoading">
                    @if (isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="text-white" />
                    }
                    else
                    {
                        <span>Registrarse</span>
                    }
                </MudButton>
            </EditForm>

            <div class="text-center register-footer mt-4">
                <span>¿Ya tienes una cuenta? </span>
                <a @onclick="VolverAlLogin" class="link-custom fw-bold text-decoration-none" style="cursor: pointer;">Inicia sesión</a>
            </div>
        </div>
    </div>
</div>

<style>
    .onboarding-container {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(180deg, #2c323f 0%, #3b4252 25%, #7e8697 50%, #e2e5eb 75%, #ffffff 100%);
        padding: 24px 20px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        box-sizing: border-box;
        overflow-x: hidden;
        overflow-y: auto;
    }

    .register-wrapper {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: auto;
        margin-bottom: auto;
        width: 100%;
    }

    .shield-badge {
        position: absolute;
        top: -30px;
        background: #3b4252;
        width: 60px;
        height: 60px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        box-shadow: 0 10px 20px rgba(0,0,0,0.2);
    }

    .register-card {
        background: #ffffff;
        color: #1f2937;
        width: 100%;
        border-radius: 24px;
        padding: 40px 20px 24px 20px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }

    .register-header h3 {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .register-header span {
        color: #6b7280;
        font-size: 12px;
        line-height: 1.4;
        display: block;
    }

    .input-label {
        font-size: 13px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 6px;
        display: block;
    }

    .btn-dark-custom {
        background-color: #181c24 !important;
        color: white !important;
        border-radius: 28px !important;
        padding: 14px 20px !important;
        text-transform: none !important;
        font-weight: 600 !important;
        box-shadow: 0 4px 14px rgba(24, 28, 36, 0.25) !important;
    }

    .link-custom {
        color: #181c24 !important;
        cursor: pointer;
    }

        .link-custom:hover {
            color: #3b4252 !important;
            text-decoration: underline !important;
        }

    .register-footer {
        font-size: 13px;
        color: #6b7280;
    }

    @@media (min-width: 768px) {
        .onboarding-container {
            align-items: center;
            justify-content: center;
        }

        .register-wrapper {
            width: 450px;
        }
    }
</style>

@code {
    private bool isLoading = false;
    private RegisterRequest registerModel = new();

    private void VolverAlLogin()
    {
        Navigation.NavigateTo("/");
    }

    private async Task HandleRegister()
    {
        isLoading = true;
        try
        {
            var success = await AuthService.RegisterAsync(registerModel);
            if (success)
            {
                Snackbar.Add("¡Cuenta creada con éxito! Ya puedes iniciar sesión.", Severity.Success);
                Navigation.NavigateTo("/");
            }
            else
            {
                Snackbar.Add("No se pudo completar el registro. Verifica los datos.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}