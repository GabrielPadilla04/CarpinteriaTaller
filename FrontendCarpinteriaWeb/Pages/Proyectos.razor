@page "/proyectos"
@using FrontendCarpinteriaWeb.DTOs.Proyecto.Response
@inject HttpClient Http
@inject IDialogService DialogService

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark m-0">Gestión de Proyectos</h4>
            <p class="text-muted small m-0">Listado general de obras activas y su estado en el taller</p>
        </div>
        <!-- Botón para creación de proyectos -->
        <button class="btn btn-dark d-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm" @onclick="AbrirModalNuevo">
            <i class="bi bi-plus-lg"></i>
            <span class="fw-semibold small">Nuevo Proyecto</span>
        </button>
    </div>

    @if (_cargando)
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 300px;">
            <div class="spinner-border text-dark" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Tarjeta contenedora de la tabla -->
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <!-- Barra de Filtros Interna -->
            <div class="row mb-3">
                <div class="col-12 col-md-4">
                    <input type="text" class="form-control form-control-sm rounded-3" placeholder="Filtrar por proyecto o cliente..."
                           @bind="_filtroBusqueda" @bind:event="oninput" />
                </div>
            </div>

            @if (_proyectosFiltrados == null || !_proyectosFiltrados.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted small">No se encontraron proyectos registrados en el sistema.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="py-3">Proyecto</th>
                                <th class="py-3">Cliente</th>
                                <th class="py-3">Responsable</th>
                                <th class="py-3">Estado</th>
                                <th class="py-3">Estado Taller</th>
                                <th class="py-3">Fecha Creación</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _proyectosFiltrados)
                            {
                                <tr>
                                    <td class="fw-semibold text-dark">@p.NombreProyecto</td>
                                    <td class="text-muted">@p.NombreCliente</td>
                                    <td class="text-muted">@p.NombreResponsable</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@p.NombreEstado</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@p.EstadoTaller</span>
                                    </td>
                                    <td class="text-muted small">@p.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _cargando = true;
    private List<ProyectoListadoResponse> _proyectos = new();
    private string _filtroBusqueda = string.Empty;

    private IEnumerable<ProyectoListadoResponse> _proyectosFiltrados =>
        string.IsNullOrWhiteSpace(_filtroBusqueda)
            ? _proyectos
            : _proyectos.Where(p =>
                p.NombreProyecto.Contains(_filtroBusqueda, StringComparison.OrdinalIgnoreCase) ||
                p.NombreCliente.Contains(_filtroBusqueda, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await CargarProyectos();
    }

    private async Task CargarProyectos()
    {
        try
        {
            _cargando = true;
            _proyectos = await Http.GetFromJsonAsync<List<ProyectoListadoResponse>>("api/proyectos?page=1&pageSize=50") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar proyectos: {ex.Message}");
        }
        finally
        {
            _cargando = false;
            StateHasChanged();
        }
    }

    private async Task AbrirModalNuevo()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ModalCrearProyecto>("Nuevo Proyecto", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await CargarProyectos();
        }
    }
}