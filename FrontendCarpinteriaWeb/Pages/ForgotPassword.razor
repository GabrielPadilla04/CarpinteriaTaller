@page "/forgot-password"
@using FrontendCarpinteriaWeb.Services
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthService AuthService

<div class="onboarding-container">
    <div class="d-flex align-items-center mb-3" style="max-width: 450px; width: 100%; margin: 0 auto;">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Class="text-dark bg-light rounded-circle shadow-sm p-2"
                       OnClick="VolverAlLogin" />
        <span class="ms-3 fw-bold" style="font-size: 16px; color: #111827;">Recuperar contraseña</span>
    </div>

    <div class="forgot-wrapper">
        <div class="shield-badge shadow-sm">
            <MudIcon Icon="@Icons.Material.Filled.Security" Class="text-white" Style="font-size: 28px;" />
        </div>

        <div class="forgot-card shadow-sm">
            @if (pasoActual == 1)
            {
                <div class="forgot-header text-center mb-4">
                    <h3>¿Has olvidado tu contraseña?</h3>
                    <span>Se enviará un código de verificación a su correo electrónico para restablecer su contraseña.</span>
                </div>

                <div class="mb-4">
                    <label class="input-label">Email</label>
                    <MudTextField @bind-Value="email"
                                  Placeholder="Usuario@gmail.com"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email"
                                  Class="custom-input rounded-lg" />
                </div>

                <MudButton Variant="Variant.Filled"
                           Class="btn-dark-custom mb-3"
                           FullWidth="true"
                           Disabled="isLoading"
                           OnClick="EnviarCodigo">
                    @if (isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="text-white" />
                    }
                    else
                    {
                        <span>Enviar código de verificación</span>
                    }
                </MudButton>
            }
            else if (pasoActual == 2)
            {
                <div class="forgot-header text-center mb-4">
                    <h3>Verifica tu código</h3>
                    <span>Se ha enviado un código de restablecimiento a <b>@email</b>, revise su correo electrónico para continuar.</span>
                </div>

                <div class="mb-4">
                    <label class="input-label">Código de verificación (6 dígitos)</label>
                    <MudTextField @bind-Value="codigoOtp"
                                  Placeholder="123456"
                                  Variant="Variant.Outlined"
                                  MaxLength="6"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.VpnKey"
                                  Class="custom-input rounded-lg" />
                </div>

                <div class="text-center mb-4" style="font-size: 12px;">
                    <span class="text-muted">¿No has recibido el código? </span>
                    <a class="link-custom fw-bold text-decoration-none" @onclick="EnviarCodigo" style="cursor: pointer;">Reenviarlo</a>
                </div>

                <MudButton Variant="Variant.Filled"
                           Class="btn-dark-custom mb-3"
                           FullWidth="true"
                           Disabled="isLoading"
                           OnClick="VerificarOtp">
                    @if (isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="text-white" />
                    }
                    else
                    {
                        <span>Continuar</span>
                    }
                </MudButton>
            }
            else if (pasoActual == 3)
            {
                <div class="forgot-header text-center mb-4">
                    <h3>Establecer nueva contraseña</h3>
                    <span>Por favor, establezca una nueva contraseña para proteger su cuenta.</span>
                </div>

                <div class="mb-3">
                    <label class="input-label">Contraseña</label>
                    <MudTextField @bind-Value="nuevaPassword"
                                  Placeholder="Nueva contraseña"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Lock"
                                  Class="custom-input rounded-lg" />
                </div>

                <div class="mb-4">
                    <label class="input-label">Confirmar Contraseña</label>
                    <MudTextField @bind-Value="confirmaPassword"
                                  Placeholder="Confirme su contraseña"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.LockReset"
                                  Class="custom-input rounded-lg" />
                </div>

                <MudButton Variant="Variant.Filled"
                           Class="btn-dark-custom mb-3"
                           FullWidth="true"
                           Disabled="isLoading"
                           OnClick="CambiarPassword">
                    @if (isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="text-white" />
                    }
                    else
                    {
                        <span>Actualizar contraseña</span>
                    }
                </MudButton>
            }
            else if (pasoActual == 4)
            {
                <div class="forgot-header text-center mb-4">
                    <h3>¡Contraseña actualizada!</h3>
                    <span class="text-muted">Para iniciar sesión en su cuenta, haga clic en el botón e introduzca sus nuevas credenciales.</span>
                </div>

                <MudButton Variant="Variant.Filled"
                           Class="btn-dark-custom mb-3"
                           FullWidth="true"
                           OnClick="VolverAlLogin">
                    <span>Iniciar sesión</span>
                </MudButton>
            }
        </div>
    </div>
</div>

<style>
    .onboarding-container {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(180deg, #2c323f 0%, #3b4252 25%, #7e8697 50%, #e2e5eb 75%, #ffffff 100%);
        padding: 24px 20px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        box-sizing: border-box;
        overflow-x: hidden;
        overflow-y: auto;
    }

    .forgot-wrapper {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: auto;
        margin-bottom: auto;
        width: 100%;
    }

    .shield-badge {
        position: absolute;
        top: -30px;
        background: #3b4252;
        width: 60px;
        height: 60px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        box-shadow: 0 10px 20px rgba(0,0,0,0.2);
    }

    .forgot-card {
        background: #ffffff;
        color: #1f2937;
        width: 100%;
        border-radius: 24px;
        padding: 40px 20px 24px 20px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }

    .forgot-header h3 {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .forgot-header span {
        color: #6b7280;
        font-size: 12px;
        line-height: 1.4;
        display: block;
    }

    .input-label {
        font-size: 13px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 6px;
        display: block;
    }

    .btn-dark-custom {
        background-color: #181c24 !important;
        color: white !important;
        border-radius: 28px !important;
        padding: 14px 20px !important;
        text-transform: none !important;
        font-weight: 600 !important;
        box-shadow: 0 4px 14px rgba(24, 28, 36, 0.25) !important;
    }

    .link-custom {
        color: #181c24 !important;
        cursor: pointer;
    }

        .link-custom:hover {
            color: #3b4252 !important;
            text-decoration: underline !important;
        }

    @@media (min-width: 768px) {
        .onboarding-container {
            align-items: center;
            justify-content: center;
        }

        .forgot-wrapper {
            width: 450px;
        }
    }
</style>

@code {
    private int pasoActual = 1;
    private bool isLoading = false;
    private string email = string.Empty;
    private string codigoOtp = string.Empty;
    private string nuevaPassword = string.Empty;
    private string confirmaPassword = string.Empty;

    private void VolverAlLogin()
    {
        Navigation.NavigateTo("/");
    }

    private async Task EnviarCodigo()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            Snackbar.Add("Por favor, ingresa tu correo electrónico.", Severity.Warning);
            return;
        }

        isLoading = true;
        try
        {
            var success = await AuthService.ForgotPasswordAsync(email);
            if (success)
            {
                Snackbar.Add("Código enviado correctamente.", Severity.Success);
                pasoActual = 2;
            }
            else
            {
                Snackbar.Add("No se pudo procesar la solicitud.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void VerificarOtp()
    {
        if (string.IsNullOrWhiteSpace(codigoOtp) || codigoOtp.Length < 6)
        {
            Snackbar.Add("Ingresa un código OTP válido de 6 dígitos.", Severity.Warning);
            return;
        }
        pasoActual = 3;
    }

    private async Task CambiarPassword()
    {
        if (string.IsNullOrWhiteSpace(nuevaPassword) || nuevaPassword.Length < 6)
        {
            Snackbar.Add("La contraseña debe tener al menos 6 caracteres.", Severity.Warning);
            return;
        }

        if (nuevaPassword != confirmaPassword)
        {
            Snackbar.Add("Las contraseñas no coinciden.", Severity.Error);
            return;
        }

        isLoading = true;
        try
        {
            var success = await AuthService.ResetPasswordAsync(email, codigoOtp, nuevaPassword);
            if (success)
            {
                Snackbar.Add("¡Contraseña actualizada con éxito!", Severity.Success);
                pasoActual = 4;
            }
            else
            {
                Snackbar.Add("El código es incorrecto o ha expirado.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}