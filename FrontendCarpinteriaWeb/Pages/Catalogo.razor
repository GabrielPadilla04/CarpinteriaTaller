@page "/catalogo"
@page "/catalogo-materiales"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using FrontendCarpinteriaWeb.DTOs.CategoriaMaterial.Response
@using FrontendCarpinteriaWeb.DTOs.Material.Response
@using System.Text.Json

<div class="container-fluid py-4">
    <!-- Encabezado y Acción -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark m-0">Catálogo de Materiales y Acabados</h4>
            <p class="text-muted small m-0">Listado general de insumos, marcas y especificaciones técnicas</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-dark d-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm" @onclick="AbrirModalCrearCategoria">
                <i class="bi bi-folder-plus"></i>
                <span class="fw-semibold small">Nueva Categoría</span>
            </button>
            <button class="btn btn-dark d-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm" @onclick="() => AbrirModalMaterial()">
                <i class="bi bi-plus-lg"></i>
                <span class="fw-semibold small">Agregar Material</span>
            </button>
        </div>
    </div>

    @if (_cargando)
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 300px;">
            <div class="spinner-border text-dark" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <!-- Barra de Filtro Interno -->
            <div class="row mb-3">
                <div class="col-12 col-md-4">
                    <input type="text" class="form-control form-control-sm rounded-3" placeholder="Filtrar por diseño, marca, acabado o categoría..."
                           @bind="_filtroBusqueda" @bind:event="oninput" />
                </div>
            </div>

            @if (_materialesFiltrados == null || !_materialesFiltrados.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted small">No se encontraron materiales registrados en el sistema.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="py-3" style="width: 70px;">Imagen</th>
                                <th class="py-3">Diseño / Color</th>
                                <th class="py-3">Marca / Proveedor</th>
                                <th class="py-3">Categoría</th>
                                <th class="py-3">Acabado</th>
                                <th class="py-3">Espesor</th>
                                <th class="py-3 text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mat in _materialesFiltrados)
                            {
                                <tr>
                                    <td>
                                        <div class="rounded border bg-light d-flex align-center justify-center overflow-hidden" style="width: 50px; height: 50px;">
                                            @if (!string.IsNullOrWhiteSpace(mat.ImagenUrl))
                                            {
                                                <img src="@mat.ImagenUrl" alt="@mat.NombreColorDiseno" style="width: 100%; height: 100%; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-image text-muted" style="font-size: 1.2rem;"></i>
                                            }
                                        </div>
                                    </td>
                                    <td class="fw-semibold text-dark">@mat.NombreColorDiseno</td>
                                    <td class="text-muted">@mat.MarcaProveedor</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(mat.NombreCategoria) ? "Sin Categoría" : mat.NombreCategoria)</span>
                                    </td>
                                    <td class="text-muted">@(string.IsNullOrEmpty(mat.Acabado) ? "-" : mat.Acabado)</td>
                                    <td class="text-muted">@(string.IsNullOrEmpty(mat.EspesorDisponible) ? "-" : mat.EspesorDisponible)</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-dark me-1" title="Editar" @onclick="() => AbrirModalMaterial(mat)">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _cargando = true;
    private List<MaterialListadoResponse> _materiales = new();
    private string _filtroBusqueda = string.Empty;

    private IEnumerable<MaterialListadoResponse> _materialesFiltrados =>
        string.IsNullOrWhiteSpace(_filtroBusqueda)
            ? _materiales
            : _materiales.Where(m =>
                (m.NombreColorDiseno != null && m.NombreColorDiseno.Contains(_filtroBusqueda, StringComparison.OrdinalIgnoreCase)) ||
                (m.MarcaProveedor != null && m.MarcaProveedor.Contains(_filtroBusqueda, StringComparison.OrdinalIgnoreCase)) ||
                (m.NombreCategoria != null && m.NombreCategoria.Contains(_filtroBusqueda, StringComparison.OrdinalIgnoreCase)) ||
                (m.Acabado != null && m.Acabado.Contains(_filtroBusqueda, StringComparison.OrdinalIgnoreCase)) ||
                (m.EspesorDisponible != null && m.EspesorDisponible.Contains(_filtroBusqueda, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        await CargarMateriales();
    }

    private async Task CargarMateriales()
    {
        try
        {
            _cargando = true;
            var response = await Http.GetAsync("api/materiales?page=1&pageSize=100");
            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

                try
                {
                    _materiales = JsonSerializer.Deserialize<List<MaterialListadoResponse>>(jsonString, options) ?? new();
                }
                catch
                {
                    var wrapper = JsonSerializer.Deserialize<MaterialPaginadoWrapper>(jsonString, options);
                    _materiales = wrapper?.Items ?? wrapper?.Resultado ?? wrapper?.Data ?? new();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar materiales: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cargando = false;
            StateHasChanged();
        }
    }

    private async Task AbrirModalMaterial(MaterialListadoResponse? material = null)
    {
        var parameters = new DialogParameters();
        if (material != null)
        {
            parameters.Add("MaterialEdicion", material);
        }

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var title = material == null ? "Agregar Material" : "Editar Material";
        var dialog = await DialogService.ShowAsync<ModalCrearMaterial>(title, parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await CargarMateriales();
        }
    }

    private async Task AbrirModalCrearCategoria()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ModalCrearCategoria>("Nueva Categoría de Material", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await CargarMateriales();
        }
    }

    private class MaterialPaginadoWrapper
    {
        public List<MaterialListadoResponse>? Items { get; set; }
        public List<MaterialListadoResponse>? Resultado { get; set; }
        public List<MaterialListadoResponse>? Data { get; set; }
    }
}