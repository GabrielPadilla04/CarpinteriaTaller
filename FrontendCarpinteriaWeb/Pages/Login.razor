@page "/"
@using FrontendCarpinteriaWeb.DTOs.Login
@using FrontendCarpinteriaWeb.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<div class="carpentry-landing-container">
    <div class="carpentry-card-wrapper shadow-lg">

        <!-- Panel Izquierdo: Identidad de Carpintería -->
        <div class="carpentry-brand-side">
            <div class="brand-content">
                <div class="wood-badge mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Carpenter" Size="Size.Large" Class="text-warning mb-2" />
                    <h2>Sistema de Carpintería</h2>
                </div>
                <p class="text-light opacity-75">Controlá tus proyectos, gestioná proveedores, optimizá materiales y lleva la administración de tu taller al siguiente nivel.</p>

                <div class="mt-4 feature-list">
                    <div class="d-flex align-items-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="me-2 text-success" />
                        <span class="small">Gestión de stock y materiales</span>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="me-2 text-success" />
                        <span class="small">Control de proveedores y órdenes</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="me-2 text-success" />
                        <span class="small">Acceso seguro con autenticación JWT</span>
                    </div>
                </div>
            </div>
            <div class="brand-footer small opacity-50">
                &copy; 2026 - Frontend Carpinteria Web
            </div>
        </div>

        <!-- Panel Derecho: Formulario de Acceso Limpio -->
        <div class="carpentry-form-side">
            <div class="form-header mb-4">
                <h3 class="fw-bold">Bienvenido</h3>
                <p class="text-muted small">Ingresa tus credenciales para acceder al panel</p>
            </div>

            <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Correo Electrónico</label>
                    <MudTextField @bind-Value="loginModel.Email"
                                  Placeholder="usuario@taller.com"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Contraseña</label>
                    <MudTextField @bind-Value="loginModel.Password"
                                  Placeholder="••••••••"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="InputType.Password"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Lock" />
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <MudCheckBox @bind-Value="rememberMe" Label="Recordarme" Color="Color.Dark" Dense="true" Size="Size.Small" />
                    <MudLink Typo="Typo.caption" Class="fw-bold text-dark text-decoration-none" OnClick="IrARecuperarPassword">¿Olvidaste tu contraseña?</MudLink>
                </div>

                <MudButton Variant="Variant.Filled"
                           ButtonType="ButtonType.Submit"
                           Class="btn-custom-dark w-100 py-2 mb-3"
                           Disabled="isLoading">
                    @if (isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="text-white" />
                    }
                    else
                    {
                        <span>Iniciar Sesión</span>
                    }
                </MudButton>
            </EditForm>

            <div class="text-center mt-3">
                <span class="text-muted small">¿No tienes una cuenta en el sistema? </span>
                <MudLink Typo="Typo.body2" OnClick="IrARegistro" Class="fw-bold text-dark text-decoration-none">Regístrate</MudLink>
            </div>
        </div>

    </div>
</div>

<style>
    .carpentry-landing-container {
        width: 100vw;
        min-height: 100vh;
        background: linear-gradient(135deg, #1e2028 0%, #2c323f 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        box-sizing: border-box;
    }

    .carpentry-card-wrapper {
        display: flex;
        width: 900px;
        max-width: 100%;
        min-height: 520px;
        background: #ffffff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    }

    .carpentry-brand-side {
        flex: 1;
        background: linear-gradient(180deg, #181c24 0%, #2c323f 100%);
        color: white;
        padding: 40px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .carpentry-form-side {
        flex: 1;
        padding: 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: #ffffff;
    }

    .btn-custom-dark {
        background-color: #181c24 !important;
        color: white !important;
        border-radius: 10px !important;
        text-transform: none !important;
        font-weight: 600 !important;
    }

        .btn-custom-dark:hover {
            background-color: #2c323f !important;
        }

    @@media (max-width: 768px) {
        .carpentry-card-wrapper {
            flex-direction: column;
            width: 100%;
        }

        .carpentry-brand-side {
            padding: 25px;
        }

        .carpentry-form-side {
            padding: 25px;
        }
    }
</style>

@code {
    private bool rememberMe = false;
    private bool isLoading = false;
    private LoginRequest loginModel = new();

    private void IrARegistro()
    {
        Navigation.NavigateTo("/register");
    }

    private void IrARecuperarPassword()
    {
        Navigation.NavigateTo("/forgot-password");
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        try
        {
            var resultado = await AuthService.LoginAsync(loginModel.Email, loginModel.Password);

            if (resultado != null && !string.IsNullOrEmpty(resultado.Token))
            {
                // Mostramos un mensaje flotante en pantalla con el rol exacto recibido
                Snackbar.Add($"Login OK. Rol recibido: {resultado.RolesId}", Severity.Info);

                // Imprimimos en la consola de depuración del navegador (F12 -> Console)
                System.Diagnostics.Debug.WriteLine($"VALOR DE ROL RECIBIDO: {resultado.RolesId}");

                if (resultado.RolesId == 2)
                {
                    Navigation.NavigateTo("/acceso-restringido");
                }
                else
                {
                    Navigation.NavigateTo("/dashboard");
                }
            }
            else
            {
                Snackbar.Add("Credenciales incorrectas o error de conexión.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}