@using FrontendCarpinteriaWeb.DTOs.Proyecto.Request
@using FrontendCarpinteriaWeb.DTOs.Cliente.Response
@using FrontendCarpinteriaWeb.DTOs.Usuario.Output
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValido">
            <!-- Nombre del Proyecto -->
            <MudTextField @bind-Value="_modelo.NombreProyecto"
                          Label="Nombre del Proyecto / Amoblamiento"
                          Placeholder="Ej. Bajo Mesada y Alacena"
                          Required="true"
                          RequiredError="El nombre del proyecto es obligatorio."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3" />

            <!-- Cliente Asignado -->
            <MudAutocomplete T="ClienteResponse"
                             Label="Cliente Asignado"
                             Value="_clienteSeleccionado"
                             ValueChanged="OnClienteChanged"
                             SearchFunc="BuscarClientes"
                             ToStringFunc="@(c => c?.NombreApellido ?? string.Empty)"
                             Placeholder="Escribe para buscar cliente..."
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Required="true"
                             RequiredError="Debe seleccionar un cliente válido."
                             ResetValueOnEmptyText="true"
                             CoerceText="false"
                             MinChars="0"
                             OpenOnFocus="true"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             Class="mb-3" />

            <!-- Responsable (Usuario) -->
            <MudAutocomplete T="UsuarioDtoOutput"
                             Label="Responsable (Usuario)"
                             Value="_usuarioSeleccionado"
                             ValueChanged="OnUsuarioChanged"
                             SearchFunc="BuscarUsuarios"
                             ToStringFunc="@(u => u is not null ? $"{u.Nombre} {u.Apellido}".Trim() : string.Empty)"
                             Placeholder="Escribe para buscar responsable..."
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Required="true"
                             RequiredError="Debe seleccionar un responsable."
                             ResetValueOnEmptyText="true"
                             CoerceText="false"
                             MinChars="0"
                             OpenOnFocus="true"
                             AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                             Class="mb-3" />

            <!-- Observaciones -->
            <MudTextField @bind-Value="_modelo.Observaciones"
                          Label="Observaciones / Notas"
                          Placeholder="Detalles de materiales o medidas..."
                          Lines="3"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Dark" Variant="Variant.Filled" Disabled="_cargando" OnClick="Guardar">
            @if (_cargando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">Guardando...</span>
            }
            else
            {
                <span>Crear Proyecto</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudBlazor.IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm _form = default!;
    private bool _isValido;
    private bool _cargando;
    private CrearProyectoRequest _modelo = new() { EstadoId = 1 };

    private List<ClienteResponse> _listaClientes = new();
    private List<UsuarioDtoOutput> _listaUsuarios = new();

    private ClienteResponse? _clienteSeleccionado;
    private UsuarioDtoOutput? _usuarioSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAuxiliares();
    }

    private async Task CargarDatosAuxiliares()
    {
        try
        {
            _listaClientes = await Http.GetFromJsonAsync<List<ClienteResponse>>("api/clientes?page=1&pageSize=100") ?? new();
            _listaUsuarios = await Http.GetFromJsonAsync<List<UsuarioDtoOutput>>("api/usuarios") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar auxiliares: {ex.Message}");
        }
    }

    private Task<IEnumerable<ClienteResponse>> BuscarClientes(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<ClienteResponse>>(_listaClientes);

        return Task.FromResult(_listaClientes.Where(c => c.NombreApellido != null && c.NombreApellido.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private Task<IEnumerable<UsuarioDtoOutput>> BuscarUsuarios(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<UsuarioDtoOutput>>(_listaUsuarios);

        return Task.FromResult(_listaUsuarios.Where(u =>
            (!string.IsNullOrEmpty(u.Nombre) && u.Nombre.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(u.Apellido) && u.Apellido.Contains(value, StringComparison.OrdinalIgnoreCase))
        ));
    }

    private void OnClienteChanged(ClienteResponse cliente)
    {
        _clienteSeleccionado = cliente;
        _modelo.ClienteId = cliente?.ClienteId ?? 0;
    }

    private void OnUsuarioChanged(UsuarioDtoOutput usuario)
    {
        _usuarioSeleccionado = usuario;
        _modelo.UsuarioId = usuario?.UsuarioId ?? 0;
    }

    private async Task Guardar()
    {
        await _form.Validate();
        if (!_isValido || _modelo.ClienteId <= 0 || _modelo.UsuarioId <= 0)
        {
            Snackbar.Add("Por favor complete todos los campos obligatorios.", Severity.Warning);
            return;
        }

        try
        {
            _cargando = true;
            var response = await Http.PostAsJsonAsync("api/proyectos", _modelo);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("¡Proyecto creado exitosamente!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al crear: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}